# dev ใช้ SQLite; production เปลี่ยน provider ใน schema.prisma เป็น mysql แล้วใช้ mysql://user:pass@localhost:3306/ecom
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Login ผ่าน Google: OAuth Client ID (Web application) จาก Google Cloud Console — เว้นว่างเพื่อซ่อนปุ่ม
GOOGLE_CLIENT_ID=""
