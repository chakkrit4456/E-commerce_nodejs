{
  "name": "jitd-ecommerce",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:setup": "npm run db:push -w apps/api && npm run db:seed -w apps/api",
    "test": "npm test -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
